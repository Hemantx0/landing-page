{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/reset-password",
        "destination": "/reset-password.html"
      },
      {
        "source": "/account-action",
        "destination": "/reset-password.html"
      },
      {
        "source": "/__/auth/action",
        "destination": "/reset-password.html"
      },
      {
        "source": "/premium-checkout",
        "destination": "/premium-checkout.html"
      }
    ],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/privacy.html",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/community",
        "destination": "/community-guidelines",
        "type": 301
      },
      {
        "source": "/community.html",
        "destination": "/community-guidelines",
        "type": 301
      },
      {
        "source": "/guidelines",
        "destination": "/community-guidelines",
        "type": 301
      },
      {
        "source": "/account-deletion.html",
        "destination": "/account-deletion",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/reset-password.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/premium-checkout",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "/premium-checkout.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ]
  }
}
